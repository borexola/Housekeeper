{
  "Housekeeper": {
    "HomeAssistant": {
      "BaseUrl": "http://homeassistant.local:8123",
      "TokenEnvironmentVariable": "HOUSEKEEPER_HA_TOKEN",
      "RequestTimeout": "00:00:30",
      "ResolveAreas": true
    },
    "Llm": {
      "Provider": "Ollama",
      "Endpoint": "http://localhost:11434",
      "Model": "qwen2.5:7b",
      "ApiKeyEnvironmentVariable": "HOUSEKEEPER_LLM_API_KEY",
      "Timeout": "00:01:30",
      "Temperature": 0.1,
      "MaxOutputTokens": 1200,
      "MaxCandidateEntities": 40,
      "MaxAttempts": 3
    },
    "Scan": {
      "Enabled": true,
      "Interval": "00:05:00",
      "History": "14.00:00:00",
      "IncludeAll": true,
      "Include": [],
      "Exclude": [
        "sensor.*_uptime",
        "sensor.sun_*"
      ],
      "MaxTrackedEntities": 500,
      "MinimumStuckDuration": "00:10:00",
      "StuckMultiplier": 3.0,
      "MinimumUnavailableDuration": "00:30:00",
      "OutlierThreshold": 4.0,
      "MinimumSamples": 12,
      "RedetectAfter": "7.00:00:00"
    },
    "Api": {
      "BindAddress": "127.0.0.1",
      "Port": 5080,
      "TokenEnvironmentVariable": "HOUSEKEEPER_API_TOKEN",
      "IngressAddress": ""
    },
    "Storage": {
      "Path": "/data/housekeeper.db",
      "KeepDecidedFor": "30.00:00:00"
    }
  }
}
